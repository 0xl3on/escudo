<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>escudo audit — {{project_name}}</title>
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body { font-family: "Palatino Linotype", Palatino, "Book Antiqua", Georgia, serif; color: #111; background: #fff; line-height: 1.6; font-size: 11pt; }
  code, .mono { font-family: "Courier New", Courier, monospace; font-size: 0.9em; }
  .container { max-width: 42rem; margin: 0 auto; padding: 3rem 2rem; }

  /* Title block — centered, document-style */
  header { text-align: center; margin-bottom: 2.5rem; padding-bottom: 1.5rem; border-bottom: 1.5pt solid #111; }
  header h1 { font-size: 1.6rem; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; margin-bottom: 0.3rem; }
  header .subtitle { font-size: 1rem; font-style: italic; color: #444; margin-bottom: 0.8rem; }
  header .meta { font-size: 0.85rem; color: #555; }
  header .meta span { margin: 0 0.5rem; }
  header .meta span:first-child { margin-left: 0; }
  .verdict { font-size: 0.85rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; margin-top: 0.6rem; }
  .verdict-pass { color: #1a6b2a; }
  .verdict-fail { color: #a11; }

  /* Summary table — clean, no cards */
  .summary { margin: 0 0 2rem; }
  .summary table { width: 100%; border-collapse: collapse; }
  .summary th, .summary td { padding: 0.4rem 0.75rem; text-align: left; }
  .summary thead th { border-top: 1.5pt solid #111; border-bottom: 0.75pt solid #111; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.06em; color: #333; font-weight: 600; }
  .summary tbody td { border-bottom: none; font-size: 0.95rem; }
  .summary tbody tr:last-child td { border-bottom: 1.5pt solid #111; padding-bottom: 0.5rem; }
  .summary .num { font-family: "Courier New", Courier, monospace; font-weight: 700; }

  /* Sections */
  section { margin-bottom: 2rem; }
  section h2 { font-size: 1.1rem; font-weight: 700; margin-bottom: 0.6rem; }

  /* Booktabs-style tables */
  table.findings { width: 100%; border-collapse: collapse; font-size: 0.875rem; }
  table.findings thead th { border-top: 1.5pt solid #111; border-bottom: 0.75pt solid #111; padding: 0.45rem 0.6rem; text-align: left; font-weight: 600; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.04em; color: #333; }
  table.findings tbody td { padding: 0.35rem 0.6rem; border-bottom: none; vertical-align: top; }
  table.findings tbody tr:last-child td { border-bottom: 1.5pt solid #111; padding-bottom: 0.5rem; }
  table.findings tbody tr:nth-child(even) td { background: #f8f8f6; }

  /* Severity */
  .warn { color: #8a6d00; }
  .error { color: #a11; }
  .kind { font-family: "Courier New", Courier, monospace; font-size: 0.82rem; color: #555; }

  /* Description paragraphs under section headings */
  section .desc { font-size: 0.85rem; color: #555; font-style: italic; margin-bottom: 0.75rem; }

  .empty { text-align: center; padding: 1.5rem; color: #888; font-style: italic; }

  footer { margin-top: 3rem; padding-top: 0.75rem; border-top: 0.75pt solid #999; color: #999; font-size: 0.75rem; display: flex; justify-content: space-between; }
  footer a { color: #666; text-decoration: none; }
  footer a:hover { text-decoration: underline; }
</style>
</head>
<body>
<div class="container">

<header>
  <h1>Escudo</h1>
  <div class="subtitle">Supply-Chain Audit Report</div>
  <div class="meta">
    <span>{{project_name}}</span>
    &middot;
    <span>{{date}}</span>
  </div>
  {{#if clean}}
  <div class="verdict verdict-pass">Pass</div>
  {{else}}
  <div class="verdict verdict-fail">{{violations_count}} Violation{{#if violations_plural}}s{{/if}}</div>
  {{/if}}
</header>

<div class="summary">
  <table>
    <thead>
      <tr>
        <th>Metric</th>
        <th>Count</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td>Packages checked</td>
        <td class="num">{{packages_checked}}</td>
      </tr>
      <tr>
        <td>Unverified crates</td>
        <td class="num{{#if unverified_count}} error{{/if}}">{{unverified_count}}</td>
      </tr>
      <tr>
        <td>Freshness violations</td>
        <td class="num{{#if freshness_count}} warn{{/if}}">{{freshness_count}}</td>
      </tr>
      <tr>
        <td>Policy violations</td>
        <td class="num{{#if policy_count}} error{{/if}}">{{policy_count}}</td>
      </tr>
    </tbody>
  </table>
</div>

{{#if unverified_crates}}
<section>
  <h2>1. Unverified Crates</h2>
  <p class="desc">These versions were not found via the crates.io API. This may indicate yanked versions or a compromised registry response.</p>
  <table class="findings">
    <thead><tr><th>Crate</th><th>Version</th></tr></thead>
    <tbody>
    {{#each unverified_crates}}
    <tr>
      <td class="error"><strong>{{this.crate_name}}</strong></td>
      <td class="mono">{{this.version}}</td>
    </tr>
    {{/each}}
    </tbody>
  </table>
</section>
{{/if}}

{{#if freshness_violations}}
<section>
  <h2>{{#if unverified_crates}}2{{else}}1{{/if}}. Freshness Violations</h2>
  <table class="findings">
    <thead><tr><th>Crate</th><th>Version</th><th>Published</th><th>Age</th><th>Cooldown</th></tr></thead>
    <tbody>
    {{#each freshness_violations}}
    <tr>
      <td><strong>{{this.crate_name}}</strong></td>
      <td class="mono">{{this.version}}</td>
      <td>{{this.published}}</td>
      <td class="warn">{{this.age_days}}d</td>
      <td>{{this.cooldown_days}}d</td>
    </tr>
    {{/each}}
    </tbody>
  </table>
</section>
{{/if}}

{{#if policy_violations}}
<section>
  <h2>{{#if unverified_crates}}{{#if freshness_violations}}3{{else}}2{{/if}}{{else}}{{#if freshness_violations}}2{{else}}1{{/if}}{{/if}}. Policy Violations</h2>
  <table class="findings">
    <thead><tr><th>Kind</th><th>Details</th></tr></thead>
    <tbody>
    {{#each policy_violations}}
    <tr>
      <td><span class="kind">{{this.kind}}</span></td>
      <td class="error">{{this.message}}</td>
    </tr>
    {{/each}}
    </tbody>
  </table>
</section>
{{/if}}

{{#if clean}}
<section>
  <p class="empty">No violations found. All packages passed audit.</p>
</section>
{{/if}}

<footer>
  <span>Generated by <a href="https://github.com/0xl3on/escudo">escudo</a> v{{version}}</span>
  <span>{{date}}</span>
</footer>

</div>
</body>
</html>
